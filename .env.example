# VectorShield Environment Configuration
PROJECT_NAME="VectorShield"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Vector DB Configuration
VECTOR_DB_BACKEND="chroma" # options: chroma, memory_resilient
CHROMA_PERSIST_DIR="./data/chroma_db"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Security & Defense Thresholds
BLOCK_RISK_THRESHOLD=65.0
QUARANTINE_THRESHOLD=80.0
SIMILARITY_OUTLIER_SIGMA=2.2
CANARY_TOKEN="VS-CANARY-SEC-9981-SECRET"

# Allowed outbound URL domains for RAG output validation
ALLOWED_DOMAINS="wikipedia.org,github.com,arxiv.org,huggingface.co"

# Database Configuration
DATABASE_URL="sqlite:///./vectorshield.db"
